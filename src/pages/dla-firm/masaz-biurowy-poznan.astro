      gap: 10px;
      padding: 10px;
      border-radius: 18px;
    }
    .b-sticky-tekst, .b-sticky-mail { display: none; }
    .b-sticky-tel, .b-sticky-msg { display: inline-flex; flex: 1; }
    .b-sticky .b-btn { height: 48px; padding-inline: 12px; }
