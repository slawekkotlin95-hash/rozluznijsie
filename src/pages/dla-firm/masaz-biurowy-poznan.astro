</style>

<script>
  // Delikatne wejście sekcji i pasek CTA, który pokazuje się po hero.
  const sekcje = document.querySelectorAll('.biuro .b-sekcja, .biuro .b-cta, .biuro .b-manifest')
  sekcje.forEach((s) => s.classList.add('b-anim'))

  const obserwator = new IntersectionObserver(
    (wpisy) => {
      wpisy.forEach((w) => {
        if (!w.isIntersecting) return
        w.target.setAttribute('data-widoczne', '')
        obserwator.unobserve(w.target)
      })
    },
    { rootMargin: '0px 0px -12% 0px' }
  )
  sekcje.forEach((s) => obserwator.observe(s))

  const pasek = document.getElementById('b-sticky')
  const hero = document.querySelector('.biuro .b-hero')

  if (pasek && hero) {
    new IntersectionObserver(
      ([wpis]) => pasek.toggleAttribute('data-widoczne', !wpis.isIntersecting),
      { threshold: 0 }
    ).observe(hero)
  }
</script>
