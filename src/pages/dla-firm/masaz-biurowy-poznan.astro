    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .b-sticky[data-widoczne] { opacity: 1; visibility: visible; transform: none; }
