---
/**
 * Edytor wpisu. Bez ?slug= tworzy nowy, z ?slug= otwiera istniejący.
 *
 * Edytor jest blokowy, bo blokowa jest treść wpisów na tej stronie: akapit,
 * nagłówek, lista, ramka „warto wiedzieć” i zdjęcie. Dzięki temu panel
 * operuje na tych samych elementach co komponent renderujący artykuł.
 */
import Admin from '../../layouts/Admin.astro'
---

<Admin
  tytul="Edytor wpisu"
  sekcja="blog"
  okruszki={[{ nazwa: 'Wpisy', href: '/admin/blog' }]}
>
  <div slot="akcje" style="display:flex;gap:8px;align-items:center">
    <span class="a-stan-zapisu" id="stan">—</span>
    <button class="a-btn a-btn-obrys" id="zapisz-szkic" type="button">Zapisz szkic</button>
    <button class="a-btn a-btn-glowny" id="opublikuj" type="button">Opublikuj</button>
  </div>

  <div class="a-edytor">
    <div>
      <div class="a-karta" style="margin-bottom:14px">
        <div class="a-pole">
          <label for="tytul">Tytuł wpisu</label>
          <input type="text" id="tytul" placeholder="np. Jak przygotować się do masażu" />
        </div>

        <div class="a-pole">
          <label for="lead">Lead</label>
          <textarea id="lead" rows="2" placeholder="Dwa zdania, które zobaczy czytelnik na liście wpisów i w wynikach Google."></textarea>
          <small><span id="licznik-lead" class="a-licznik">0</span> znaków, celuj w 120–160</small>
        </div>

        <div class="a-pole-rzad">
          <div class="a-pole">
            <label for="slug">Adres wpisu</label>
            <input type="text" id="slug" placeholder="jak-przygotowac-sie-do-masazu" />
            <small>rozluznijsie.pl/blog/<span id="podglad-slug">…</span></small>
          </div>
          <div class="a-pole">
            <label for="data">Data publikacji</label>
            <input type="date" id="data" />
            <small>Data w przyszłości = publikacja zaplanowana.</small>
          </div>
        </div>
      </div>

      <div class="a-bloki" id="bloki"></div>

      <div class="a-dodaj-blok">
        <button class="a-btn a-btn-obrys a-btn-maly" data-dodaj="p">+ Akapit</button>
        <button class="a-btn a-btn-obrys a-btn-maly" data-dodaj="h2">+ Nagłówek H2</button>
        <button class="a-btn a-btn-obrys a-btn-maly" data-dodaj="h3">+ Nagłówek H3</button>
        <button class="a-btn a-btn-obrys a-btn-maly" data-dodaj="lista">+ Lista</button>
        <button class="a-btn a-btn-obrys a-btn-maly" data-dodaj="ramka">+ Ramka wyróżniona</button>
        <button class="a-btn a-btn-obrys a-btn-maly" data-dodaj="zdjecie">+ Zdjęcie</button>
      </div>
    </div>

    <aside class="a-panel-boczny">
      <section class="a-panel-sekcja">
        <h2>Publikacja</h2>
        <div class="a-pole">
          <label for="status">Status</label>
          <select id="status">
            <option value="opublikowany">Opublikowany</option>
            <option value="szkic">Szkic</option>
          </select>
        </div>
        <div class="a-pole" style="margin-bottom:0">
          <label for="miniatura">Zdjęcie wyróżniające</label>
          <div style="display:flex;gap:8px;align-items:center">
            <div id="miniatura-podglad" role="img" aria-label="Zdjęcie wyróżniające" style="width:64px;height:48px;border-radius:7px;border:1px solid var(--a-linia);background:#eef1ef center/cover no-repeat"></div>
            <button class="a-btn a-btn-obrys a-btn-maly" type="button" id="wybierz-miniature">Wybierz</button>
          </div>
          <input type="hidden" id="miniatura" />
        </div>
      </section>

      <section class="a-panel-sekcja">
        <h2>SEO</h2>
        <div class="a-pole">
          <label for="metaTytul">Tytuł w Google</label>
          <input type="text" id="metaTytul" placeholder="Pusty = tytuł wpisu" />
          <small><span id="licznik-title" class="a-licznik">0</span> znaków, bezpiecznie do 60</small>
        </div>

        <p style="margin:0 0 8px;font-size:12px;font-weight:600;color:var(--a-zielen-ciemna)">Podgląd wyniku</p>
        <div class="a-podglad-google">
          <div class="tytul" id="pg-tytul">Tytuł wpisu</div>
          <div class="url" id="pg-url">rozluznijsie.pl/blog/…</div>
          <div class="opis" id="pg-opis">Lead wpisu pojawi się w tym miejscu.</div>
        </div>
      </section>

      <section class="a-panel-sekcja">
        <h2>Kontrola jakości</h2>
        <ul class="a-ostrzezenia" id="ostrzezenia"></ul>
        <p style="margin:12px 0 0;font-size:11.5px;color:var(--a-szary)">
          To pomocnicza lista kontrolna redakcji, a nie ocena od Google.
        </p>
      </section>

      <section class="a-panel-sekcja">
        <h2>Struktura nagłówków</h2>
        <ul class="a-struktura" id="struktura"></ul>
      </section>
    </aside>
  </div>

  <dialog class="a-modal" id="modal-media">
    <div class="a-modal-tresc" style="max-height:74vh;overflow:auto">
      <h2>Wybierz zdjęcie</h2>
      <p>Klikasz miniaturę, żeby ją wstawić. Nowe pliki wgrywasz w sekcji Media.</p>
      <div class="a-media" id="media-wybor" style="grid-template-columns:repeat(auto-fill,minmax(120px,1fr))"></div>
      <div class="a-modal-akcje" style="margin-top:16px">
        <button class="a-btn a-btn-obrys" id="media-zamknij" type="button">Zamknij</button>
      </div>
    </div>
  </dialog>

  <script>
    const esc = (t) => String(t ?? '').replace(/[&<>"]/g, (z) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[z]))
    const params = new URLSearchParams(location.search)
    const slugPierwotny = params.get('slug')

    const el = (id) => document.getElementById(id)
    let bloki = []
    let miniatura = 'gabinet'
    let mediaCache = null
    let celWyboru = null
    let brudny = false

    /* ---------------------------- bloki ---------------------------------- */

    const SZABLONY = {
      p: () => ({ typ: 'p', tekst: '' }),
      h2: () => ({ typ: 'h2', tekst: '' }),
      h3: () => ({ typ: 'h3', tekst: '' }),
      lista: () => ({ typ: 'lista', punkty: [''] }),
      ramka: () => ({ typ: 'ramka', tytul: 'Warto wiedzieć', tekst: '' }),
      zdjecie: () => ({ typ: 'zdjecie', klucz: '', alt: '', podpis: '' }),
    }

    const NAZWY = { p: 'Akapit', h2: 'Nagłówek H2', h3: 'Nagłówek H3', lista: 'Lista', ramka: 'Ramka', zdjecie: 'Zdjęcie' }

    function rysujBloki() {
      el('bloki').innerHTML = bloki
        .map((b, i) => {
          const naglowek = `<div class="a-blok-gora">
              <span class="a-blok-typ">${NAZWY[b.typ]}</span>
              <div class="a-blok-akcje">
                <button type="button" data-gora="${i}" aria-label="W górę" ${i === 0 ? 'disabled' : ''}>↑</button>
                <button type="button" data-dol="${i}" aria-label="W dół" ${i === bloki.length - 1 ? 'disabled' : ''}>↓</button>
                <button type="button" data-kasuj="${i}" aria-label="Usuń blok">✕</button>
              </div>
            </div>`

          if (b.typ === 'lista') {
            return `<div class="a-blok">${naglowek}
              ${b.punkty
                .map(
                  (p, j) => `<div style="display:flex;gap:6px;margin-bottom:6px">
                    <div class="a-pisak" style="flex:1" contenteditable data-blok="${i}" data-punkt="${j}" data-podpowiedz="Punkt listy">${p}</div>
                    <button type="button" class="a-btn a-btn-obrys a-btn-maly" data-kasuj-punkt="${i}:${j}">✕</button>
                  </div>`
                )
                .join('')}
              <button type="button" class="a-btn a-btn-obrys a-btn-maly" data-dodaj-punkt="${i}">+ Punkt</button>
            </div>`
          }

          if (b.typ === 'ramka') {
            return `<div class="a-blok">${naglowek}
              <div class="a-pole" style="margin-bottom:8px">
                <input type="text" value="${esc(b.tytul)}" data-ramka-tytul="${i}" placeholder="Nagłówek ramki" />
              </div>
              ${pasekFormatu(i)}
              <div class="a-pisak" contenteditable data-blok="${i}" data-podpowiedz="Treść ramki">${b.tekst}</div>
            </div>`
          }

          if (b.typ === 'zdjecie') {
            return `<div class="a-blok">${naglowek}
              <div class="a-zdjecie-blok">
                <div class="a-zdjecie-podglad" data-obraz="${i}" role="img" aria-label="Podgląd zdjęcia"></div>
                <div>
                  <button type="button" class="a-btn a-btn-obrys a-btn-maly" data-wybierz="${i}" style="margin-bottom:8px">
                    ${b.klucz ? 'Zmień zdjęcie' : 'Wybierz zdjęcie'}
                  </button>
                  <div class="a-pole" style="margin-bottom:8px">
                    <input type="text" value="${esc(b.alt)}" data-alt="${i}" placeholder="Opis alternatywny (alt)" />
                  </div>
                  <div class="a-pole" style="margin-bottom:0">
                    <input type="text" value="${esc(b.podpis || '')}" data-podpis="${i}" placeholder="Podpis pod zdjęciem (opcjonalny)" />
                  </div>
                </div>
              </div>
            </div>`
          }

          return `<div class="a-blok">${naglowek}
            ${pasekFormatu(i)}
            <div class="a-pisak" data-typ="${b.typ}" contenteditable data-blok="${i}" data-podpowiedz="${b.typ === 'p' ? 'Treść akapitu' : 'Treść nagłówka'}">${b.tekst}</div>
          </div>`
        })
        .join('')

      odswiezPodglady()
      przeliczPanel()
    }

    const pasekFormatu = (i) => `<div class="a-pasek-formatu">
        <button type="button" data-format="bold" data-cel="${i}" title="Pogrubienie">B</button>
        <button type="button" data-format="link" data-cel="${i}" title="Wstaw link">Link</button>
        <button type="button" data-format="unlink" data-cel="${i}" title="Usuń link">Bez linku</button>
      </div>`

    async function odswiezPodglady() {
      const media = await pobierzMedia()
      document.querySelectorAll('[data-obraz]').forEach((kafel) => {
        const blok = bloki[Number(kafel.dataset.obraz)]
        const plik = media.find((m) => m.plik === blok.klucz)
        kafel.style.backgroundImage = plik ? `url(/api/admin/podglad?plik=${encodeURIComponent(plik.plik)})` : 'none'
        kafel.setAttribute('aria-label', blok.alt || 'Brak wybranego zdjęcia')
      })
    }

    /* --------------------------- media ----------------------------------- */

    async function pobierzMedia() {
      if (!mediaCache) mediaCache = (await window.api('/api/admin/media')).media
      return mediaCache
    }

    async function otworzWybor(cel) {
      celWyboru = cel
      const media = await pobierzMedia()
      el('media-wybor').innerHTML = media
        .map(
          (m) => `<button type="button" class="a-media-kafel" data-plik="${esc(m.plik)}">
            <img src="/api/admin/podglad?plik=${encodeURIComponent(m.plik)}" alt="" loading="lazy" />
            <div class="a-media-opis"><strong>${esc(m.plik)}</strong></div>
          </button>`
        )
        .join('')
      el('modal-media').showModal()
    }

    el('media-wybor').addEventListener('click', (e) => {
      const kafel = e.target.closest('[data-plik]')
      if (!kafel) return
      const plik = kafel.dataset.plik

      if (celWyboru === 'miniatura') {
        miniatura = plik
        el('miniatura').value = plik
        el('miniatura-podglad').style.backgroundImage = `url(/api/admin/podglad?plik=${encodeURIComponent(plik)})`
      } else {
        bloki[celWyboru].klucz = plik
        const opis = (mediaCache || []).find((m) => m.plik === plik)
        if (opis?.alt && !bloki[celWyboru].alt) bloki[celWyboru].alt = opis.alt
        rysujBloki()
      }
      el('modal-media').close()
      oznaczZmiane()
    })

    el('media-zamknij').addEventListener('click', () => el('modal-media').close())
    el('wybierz-miniature').addEventListener('click', () => otworzWybor('miniatura'))

    /* ------------------------ obsługa edycji ------------------------------ */

    el('bloki').addEventListener('click', async (e) => {
      const cel = (sel) => e.target.closest(`[${sel}]`)
      const gora = cel('data-gora')
      const dol = cel('data-dol')
      const kasuj = cel('data-kasuj')
      const dodajPunkt = cel('data-dodaj-punkt')
      const kasujPunkt = cel('data-kasuj-punkt')
      const wybierz = cel('data-wybierz')
      const format = cel('data-format')

      if (gora) { const i = +gora.dataset.gora; [bloki[i - 1], bloki[i]] = [bloki[i], bloki[i - 1]]; rysujBloki(); oznaczZmiane() }
      if (dol) { const i = +dol.dataset.dol; [bloki[i + 1], bloki[i]] = [bloki[i], bloki[i + 1]]; rysujBloki(); oznaczZmiane() }
      if (kasuj) { bloki.splice(+kasuj.dataset.kasuj, 1); rysujBloki(); oznaczZmiane() }
      if (dodajPunkt) { bloki[+dodajPunkt.dataset.dodajPunkt].punkty.push(''); rysujBloki(); oznaczZmiane() }
      if (kasujPunkt) {
        const [i, j] = kasujPunkt.dataset.kasujPunkt.split(':').map(Number)
        bloki[i].punkty.splice(j, 1)
        if (!bloki[i].punkty.length) bloki[i].punkty.push('')
        rysujBloki(); oznaczZmiane()
      }
      if (wybierz) await otworzWybor(+wybierz.dataset.wybierz)

      if (format) {
        const pisak = format.closest('.a-blok').querySelector('.a-pisak')
        pisak.focus()
        if (format.dataset.format === 'bold') document.execCommand('bold')
        if (format.dataset.format === 'unlink') document.execCommand('unlink')
        if (format.dataset.format === 'link') {
          const adres = prompt('Adres linku (np. /masaze/klasyczny-poznan albo https://…)')
          if (adres) document.execCommand('createLink', false, adres)
        }
        zbierzZPisakow()
        oznaczZmiane()
      }
    })

    el('bloki').addEventListener('input', (e) => {
      const pisak = e.target.closest('.a-pisak')
      if (pisak) zbierzZPisakow()

      const alt = e.target.closest('[data-alt]')
      if (alt) bloki[+alt.dataset.alt].alt = alt.value
      const podpis = e.target.closest('[data-podpis]')
      if (podpis) bloki[+podpis.dataset.podpis].podpis = podpis.value
      const tytulRamki = e.target.closest('[data-ramka-tytul]')
      if (tytulRamki) bloki[+tytulRamki.dataset.ramkaTytul].tytul = tytulRamki.value

      oznaczZmiane()
      przeliczPanel()
    })

    /** Treść bloków bierzemy prosto z pól edycji, żeby nie gubić formatowania. */
    function zbierzZPisakow() {
      document.querySelectorAll('.a-pisak[data-blok]').forEach((pisak) => {
        const i = +pisak.dataset.blok
        const html = pisak.innerHTML.replace(/<br\s*\/?>/gi, ' ').trim()
        if (pisak.dataset.punkt !== undefined) bloki[i].punkty[+pisak.dataset.punkt] = html
        else bloki[i].tekst = html
      })
      przeliczPanel()
    }

    document.querySelectorAll('[data-dodaj]').forEach((btn) =>
      btn.addEventListener('click', () => {
        bloki.push(SZABLONY[btn.dataset.dodaj]())
        rysujBloki()
        oznaczZmiane()
        el('bloki').lastElementChild?.querySelector('.a-pisak, input')?.focus()
      })
    )

    /* --------------------- panel boczny i kontrola ------------------------ */

    function przeliczPanel() {
      const tytul = el('tytul').value.trim()
      const lead = el('lead').value.trim()
      const metaTytul = el('metaTytul').value.trim()
      const slug = el('slug').value.trim()

      el('podglad-slug').textContent = slug || '…'
      el('pg-tytul').textContent = (metaTytul || tytul || 'Tytuł wpisu') + ' | Rozluźnij Się'
      el('pg-url').textContent = 'rozluznijsie.pl/blog/' + (slug || '…')
      el('pg-opis').textContent = lead || 'Lead wpisu pojawi się w tym miejscu.'

      const licznikLead = el('licznik-lead')
      licznikLead.textContent = lead.length
      licznikLead.className = 'a-licznik' + (lead.length && (lead.length < 80 || lead.length > 180) ? ' a-licznik-zle' : '')

      const dlugoscTitle = (metaTytul || tytul).length + ' | Rozluźnij Się'.length
      const licznikTitle = el('licznik-title')
      licznikTitle.textContent = dlugoscTitle
      licznikTitle.className = 'a-licznik' + (dlugoscTitle > 60 ? ' a-licznik-zle' : '')

      // Lista kontrolna redakcji — świadomie bez udawanej „oceny SEO”.
      const naglowki = bloki.filter((b) => b.typ === 'h2' || b.typ === 'h3')
      const zdjecia = bloki.filter((b) => b.typ === 'zdjecie')
      const uwagi = []
      if (!tytul) uwagi.push(['Wpis nie ma tytułu', false])
      if (!lead) uwagi.push(['Brakuje leadu, który trafia do opisu w Google', false])
      if (!slug) uwagi.push(['Brakuje adresu wpisu', false])
      if (dlugoscTitle > 60) uwagi.push(['Tytuł w Google zostanie ucięty', false])
      if (!naglowki.some((b) => b.typ === 'h2')) uwagi.push(['Treść nie ma ani jednego nagłówka H2', false])
      if (zdjecia.some((z) => !z.alt)) uwagi.push(['Zdjęcie bez opisu alternatywnego', false])
      if (zdjecia.some((z) => !z.klucz)) uwagi.push(['Blok zdjęcia bez wybranego pliku', false])
      if (bloki.filter((b) => b.typ === 'p').length < 3) uwagi.push(['Mało treści: poniżej trzech akapitów', false])
      if (!uwagi.length) uwagi.push(['Wszystko na miejscu', true])

      el('ostrzezenia').innerHTML = uwagi
        .map(([tekst, ok]) => `<li class="${ok ? 'ok' : ''}">${esc(tekst)}</li>`)
        .join('')

      el('struktura').innerHTML =
        `<li data-poziom="h1">H1 · ${esc(tytul || 'tytuł wpisu')}</li>` +
        naglowki
          .map((b) => `<li data-poziom="${b.typ}">${b.typ.toUpperCase()} · ${esc(b.tekst.replace(/<[^>]+>/g, '') || '…')}</li>`)
          .join('')
    }

    ;['tytul', 'lead', 'metaTytul', 'slug', 'data', 'status'].forEach((id) =>
      el(id).addEventListener('input', () => {
        if (id === 'tytul' && !slugPierwotny && !el('slug').dataset.reczny) el('slug').value = slugify(el('tytul').value)
        if (id === 'slug') el('slug').dataset.reczny = '1'
        przeliczPanel()
        oznaczZmiane()
      })
    )

    const slugify = (t) =>
      t
        .toLowerCase()
        .replace(/[ąćęłńóśźż]/g, (z) => ({ ą: 'a', ć: 'c', ę: 'e', ł: 'l', ń: 'n', ó: 'o', ś: 's', ź: 'z', ż: 'z' }[z]))
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80)

    /* ------------------------ zapis i autosave ---------------------------- */

    const KLUCZ_KOPII = 'rozluznijsie-wpis-' + (slugPierwotny || 'nowy')
    let licznikAutosave

    function oznaczZmiane() {
      brudny = true
      el('stan').textContent = 'Niezapisane zmiany'
      clearTimeout(licznikAutosave)
      // Kopia lokalna co dwie sekundy: odświeżenie strony nie kasuje pracy.
      licznikAutosave = setTimeout(() => {
        localStorage.setItem(KLUCZ_KOPII, JSON.stringify(zbierzWpis()))
        el('stan').textContent = 'Kopia robocza zapisana w przeglądarce'
      }, 2000)
    }

    function zbierzWpis() {
      zbierzZPisakow()
      return {
        slugPierwotny,
        slug: el('slug').value.trim() || slugify(el('tytul').value),
        tytul: el('tytul').value.trim(),
        lead: el('lead').value.trim(),
        metaTytul: el('metaTytul').value.trim(),
        data: el('data').value || new Date().toISOString().slice(0, 10),
        status: el('status').value,
        miniatura,
        bloki: bloki.map(({ podglad, ...b }) => b),
      }
    }

    async function zapisz(status) {
      const wpis = { ...zbierzWpis(), status }
      if (!wpis.tytul) return window.toast('Wpis musi mieć tytuł.', true)

      el('stan').textContent = 'Zapisywanie…'
      el('zapisz-szkic').disabled = el('opublikuj').disabled = true

      try {
        await window.api('/api/admin/wpisy', { method: slugPierwotny ? 'PUT' : 'POST', dane: wpis })
        localStorage.removeItem(KLUCZ_KOPII)
        brudny = false
        el('stan').textContent = 'Zapisano przed chwilą'
        window.toast(
          status === 'szkic'
            ? 'Szkic zapisany. Nie trafi na stronę, dopóki go nie opublikujesz.'
            : 'Zapisano. Strona przebuduje się w ciągu około minuty.'
        )
        if (!slugPierwotny) location.replace('/admin/wpis?slug=' + encodeURIComponent(wpis.slug))
      } catch (e) {
        el('stan').textContent = 'Nie zapisano'
        window.toast(e.message, true)
      } finally {
        el('zapisz-szkic').disabled = el('opublikuj').disabled = false
      }
    }

    el('zapisz-szkic').addEventListener('click', () => zapisz('szkic'))
    el('opublikuj').addEventListener('click', () => zapisz('opublikowany'))

    window.addEventListener('beforeunload', (e) => {
      if (brudny) e.preventDefault()
    })

    /* ------------------------------ start --------------------------------- */

    async function wczytaj() {
      el('data').value = new Date().toISOString().slice(0, 10)

      if (slugPierwotny) {
        try {
          const { wpis } = await window.api('/api/admin/wpisy?slug=' + encodeURIComponent(slugPierwotny))
          el('tytul').value = wpis.tytul
          el('lead').value = wpis.lead
          el('metaTytul').value = wpis.metaTytul || ''
          el('slug').value = wpis.slug
          el('slug').dataset.reczny = '1'
          el('data').value = wpis.data
          el('status').value = wpis.status || 'opublikowany'
          miniatura = wpis.miniatura
          el('miniatura').value = miniatura
          bloki = wpis.bloki
        } catch (e) {
          window.toast(e.message, true)
        }
      }

      const kopia = localStorage.getItem(KLUCZ_KOPII)
      if (kopia && confirm('Znaleziono niezapisaną kopię roboczą tego wpisu. Przywrócić ją?')) {
        const dane = JSON.parse(kopia)
        el('tytul').value = dane.tytul
        el('lead').value = dane.lead
        el('metaTytul').value = dane.metaTytul || ''
        el('slug').value = dane.slug
        el('data').value = dane.data
        el('status').value = dane.status
        miniatura = dane.miniatura
        bloki = dane.bloki
      }

      if (!bloki.length) bloki = [SZABLONY.p()]

      const media = await pobierzMedia().catch(() => [])
      const plik = media.find((m) => m.plik === miniatura)
      if (plik) el('miniatura-podglad').style.backgroundImage = `url(/api/admin/podglad?plik=${encodeURIComponent(plik.plik)})`

      rysujBloki()
      el('stan').textContent = slugPierwotny ? 'Wczytano' : 'Nowy wpis'
    }

    wczytaj()
  </script>
</Admin>
