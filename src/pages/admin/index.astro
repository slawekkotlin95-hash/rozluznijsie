---
/** Pulpit: liczby, ostatnio edytowane treści i szybkie akcje. */
import Admin from '../../layouts/Admin.astro'
---

<Admin tytul="Pulpit" podtytul="Skrót tego, co dzieje się w treściach strony." sekcja="pulpit">
  <a slot="akcje" class="a-btn a-btn-glowny" href="/admin/wpis">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
    Nowy wpis
  </a>

  <div class="a-kafelki" id="kafelki">
    <div class="a-kafelek"><span>Opublikowane wpisy</span><strong id="l-opublikowane">—</strong></div>
    <div class="a-kafelek"><span>Szkice</span><strong id="l-szkice">—</strong></div>
    <div class="a-kafelek"><span>Zaplanowane</span><strong id="l-zaplanowane">—</strong></div>
    <div class="a-kafelek"><span>Zdjęcia w bibliotece</span><strong id="l-media">—</strong></div>
    <div class="a-kafelek"><span>Zdjęcia bez altu</span><strong id="l-bez-altu">—</strong></div>
  </div>

  <div class="a-karta">
    <h2 style="margin:0 0 14px;font-family:'Lato',sans-serif;font-size:16px;font-weight:900">Ostatnio dodane wpisy</h2>
    <div id="ostatnie">Wczytuję…</div>
  </div>

  <div class="a-pasek-narzedzi" style="margin-top:22px">
    <a class="a-btn a-btn-obrys" href="/admin/wpis">Dodaj wpis</a>
    <a class="a-btn a-btn-obrys" href="/admin/media">Dodaj zdjęcie</a>
    <a class="a-btn a-btn-obrys" href="/admin/blog">Wszystkie wpisy</a>
  </div>

  <script>
    const dzis = new Date().toISOString().slice(0, 10)

    const stan = (w) =>
      w.status === 'szkic' ? 'szkic' : w.data > dzis ? 'zaplanowany' : 'opublikowany'

    Promise.all([window.api('/api/admin/wpisy'), window.api('/api/admin/media')])
      .then(([wpisy, media]) => {
        const lista = wpisy.wpisy
        const licz = (s) => lista.filter((w) => stan(w) === s).length

        document.getElementById('l-opublikowane').textContent = licz('opublikowany')
        document.getElementById('l-szkice').textContent = licz('szkic')
        document.getElementById('l-zaplanowane').textContent = licz('zaplanowany')
        document.getElementById('l-media').textContent = media.media.length
        document.getElementById('l-bez-altu').textContent = media.media.filter((m) => !m.alt).length

        const ostatnie = [...lista].sort((a, b) => b.data.localeCompare(a.data)).slice(0, 5)
        document.getElementById('ostatnie').innerHTML = ostatnie.length
          ? `<table class="a-tabela"><tbody>${ostatnie
              .map(
                (w) => `<tr>
                  <td><a class="a-tabela-tytul" href="/admin/wpis?slug=${encodeURIComponent(w.slug)}">${w.tytul}</a>
                    <span class="a-tabela-slug">/blog/${w.slug}</span></td>
                  <td style="width:140px">${w.data}</td>
                  <td style="width:130px"><span class="a-plakietka a-plakietka-${stan(w)}">${stan(w)}</span></td>
                </tr>`
              )
              .join('')}</tbody></table>`
          : '<p class="a-pusto">Nie ma jeszcze żadnych wpisów.</p>'
      })
      .catch((e) => window.toast(e.message, true))
  </script>
</Admin>
