---
/** Logowanie do panelu. Sesję zakłada endpoint /api/admin/sesja. */
import { Image } from 'astro:assets'
import logo from '../../assets/output-onlinepngtools.png'
import '../../styles/admin.css'
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Logowanie · Panel Rozluźnij Się</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Jost:wght@400;500;600&display=swap"
    />
  </head>

  <body class="admin">
    <main class="a-logowanie">
      <div class="a-logowanie-karta">
        <div class="a-logowanie-marka">
          <Image src={logo} alt="Rozluźnij Się" width={124} height={124} quality={92} />
          <h1>Panel treści</h1>
          <p>Rozluźnij Się, gabinet masażu w Poznaniu</p>
        </div>

        <p class="a-komunikat a-komunikat-blad" id="komunikat" hidden></p>

        <form id="formularz" novalidate>
          <div class="a-pole">
            <label for="email">Adres e-mail</label>
            <input type="email" id="email" name="email" autocomplete="username" required autofocus />
          </div>

          <div class="a-pole">
            <label for="haslo">Hasło</label>
            <div class="a-haslo">
              <input type="password" id="haslo" name="haslo" autocomplete="current-password" required />
              <button type="button" id="pokaz" aria-label="Pokaż hasło">Pokaż</button>
            </div>
          </div>

          <label class="a-zapamietaj">
            <input type="checkbox" id="zapamietaj" />
            Zapamiętaj mnie na tym urządzeniu
          </label>

          <button class="a-btn a-btn-glowny" type="submit" id="wyslij">Zaloguj się</button>
        </form>
      </div>
    </main>

    <script>
      const formularz = document.getElementById('formularz')
      const komunikat = document.getElementById('komunikat')
      const przycisk = document.getElementById('wyslij')
      const haslo = document.getElementById('haslo')

      document.getElementById('pokaz').addEventListener('click', (e) => {
        const jawne = haslo.type === 'text'
        haslo.type = jawne ? 'password' : 'text'
        e.target.textContent = jawne ? 'Pokaż' : 'Ukryj'
        e.target.setAttribute('aria-label', jawne ? 'Pokaż hasło' : 'Ukryj hasło')
      })

      const pokazBlad = (tekst) => {
        komunikat.textContent = tekst
        komunikat.hidden = false
      }

      // Kto ma ważną sesję, ten nie ogląda formularza.
      fetch('/api/admin/sesja').then((r) => {
        if (r.ok) location.replace(new URLSearchParams(location.search).get('powrot') || '/admin')
      })

      formularz.addEventListener('submit', async (e) => {
        e.preventDefault()
        komunikat.hidden = true

        const email = document.getElementById('email').value.trim()
        const wartoscHasla = haslo.value
        if (!email || !wartoscHasla) return pokazBlad('Podaj adres e-mail i hasło.')

        przycisk.disabled = true
        przycisk.textContent = 'Logowanie…'

        try {
          const odp = await fetch('/api/admin/sesja', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, haslo: wartoscHasla, zapamietaj: document.getElementById('zapamietaj').checked }),
          })
          const wynik = await odp.json().catch(() => ({}))
          if (!odp.ok) throw new Error(wynik.blad || 'Nie udało się zalogować.')

          location.replace(new URLSearchParams(location.search).get('powrot') || '/admin')
        } catch (err) {
          pokazBlad(err.message)
          przycisk.disabled = false
          przycisk.textContent = 'Zaloguj się'
          haslo.value = ''
          haslo.focus()
        }
      })
    </script>
  </body>
</html>
