---
import { Image, getImage } from 'astro:assets'
import Layout from '../../layouts/Layout.astro'
import Cta from '../../components/Cta.astro'
import MetaWpisu from '../../components/MetaWpisu.astro'
import TrescArtykulu from '../../components/TrescArtykulu.astro'
import { wpisy, wpisyOdNajnowszych } from '../../data/strony'
import { miniaturyWpisow } from '../../data/zdjecia'
import { artykuly } from '../../data/artykuly'
import { zespol } from '../../config'

export function getStaticPaths() {
  // Wszystkie wpisy z panelu. Kobido Up ma własny plik z bogatszym układem.
  return artykuly.map((artykul) => ({
    params: { wpis: artykul.slug },
    props: { artykul, wpis: wpisy.find((w) => w.slug === artykul.slug)! },
  }))
}

const { artykul, wpis } = Astro.props
const inne = wpisyOdNajnowszych.filter((w) => w.slug !== wpis.slug).slice(0, 3)

const BAZA = 'https://rozluznijsie.pl'
const adres = `${BAZA}/blog/${artykul.slug}`
const opis = artykul.metaOpis || artykul.lead
// Obrazek do udostępnień i do Google w formacie 1200 × 630, z miniatury wpisu.
const og = await getImage({ src: miniaturyWpisow[artykul.slug], width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 })
const autor = zespol.find((o) => o.slug === artykul.autor)

const artykulSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: artykul.metaTytul || artykul.tytul,
      description: opis,
      image: new URL(og.src, BAZA).href,
      inLanguage: 'pl-PL',
      datePublished: artykul.data,
      dateModified: artykul.aktualizacja || artykul.data,
      wordCount: artykul.minuty * 200,
      mainEntityOfPage: { '@type': 'WebPage', '@id': adres },
      author: autor
        ? { '@type': 'Person', name: autor.imie, jobTitle: 'technik masażysta', url: `${BAZA}/o-nas/${autor.slug}`, worksFor: { '@id': `${BAZA}/#gabinet` } }
        : { '@id': `${BAZA}/#gabinet` },
      publisher: { '@id': `${BAZA}/#gabinet` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: BAZA },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${BAZA}/blog` },
        { '@type': 'ListItem', position: 3, name: artykul.tytul, item: adres },
      ],
    },
  ],
}
---

<Layout
  tytul={artykul.metaTytul ? `${artykul.metaTytul} | Rozluźnij Się Poznań` : `${artykul.tytul} | masaż Poznań Rozluźnij Się`}
  opis={opis}
  obraz={og.src}
  noindex={artykul.noindex}
>
  <section class="sekcja sekcja-biala">
    <div class="kontener">
      <header class="glowka-wpisu">
        <a class="pasek-powrot" href="/blog">← Wszystkie wpisy</a>
        <h1>{wpis.tytul}</h1>
        <p class="glowka-lead">{wpis.lead}</p>
        <MetaWpisu wpis={wpis} />
        {autor && <p class="podpis-autora">Autor: <a href={`/o-nas/${autor.slug}`}>{autor.imie}</a>, technik masażysta</p>}
      </header>

      <TrescArtykulu artykul={artykul} />
    </div>
  </section>

  <section class="sekcja sekcja-jasna">
    <div class="kontener">
      <p class="etykieta">Czytaj dalej</p>
      <h2 class="tytul-sekcji">Inne wpisy</h2>
      <div class="karty">
        {inne.map((w) => (
          <a class="karta" href={`/blog/${w.slug}`}>
            <div class="karta-foto">
              <Image src={miniaturyWpisow[w.slug]} alt={w.tytul} widths={[380, 640]} width={640} quality={70} sizes="(max-width: 900px) 92vw, 30vw" loading="lazy" />
            </div>
            <div class="karta-tresc">
              <MetaWpisu wpis={w} />
              <h3 class="karta-tytul">{w.tytul}</h3>
              <p class="karta-cena">{w.lead}</p>
              <span class="karta-wiecej">Czytaj →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Cta />

  <script type="application/ld+json" set:html={JSON.stringify(artykulSchema)} />
</Layout>

<style>
  /* Nagłówek wpisu: tytuł stoi nad treścią i trzyma się lewej krawędzi. */
  .glowka-wpisu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 38px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--linia);
  }

  .glowka-wpisu h1 {
    margin: 0;
    max-width: 24ch;
    font-size: clamp(28px, 3.2vw, 42px);
    color: var(--zielen-ciemna);
  }

  .glowka-lead {
    margin: 0;
    max-width: 68ch;
    font-size: 17.5px;
    line-height: 1.65;
    text-align: left;
    color: var(--szary);
  }

  .pasek-powrot {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--zielen);
    transition: color 0.18s ease;
  }

  .pasek-powrot:hover { color: var(--terakota-ciemna); }

  .karta-tresc :global(.meta-wpisu) { margin-bottom: 10px; }

  .podpis-autora { margin: 0; font-size: 14px; color: var(--szary); }
  .podpis-autora a { font-weight: 600; color: var(--zielen); }
  .podpis-autora a:hover { color: var(--terakota-ciemna); }
</style>
