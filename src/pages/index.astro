---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import { firma, masaze, wskazania, sciezkaMasazu, dzielnice } from '../config'

// Wnętrze gabinetu w najwyższej rozdzielczości, jaką mamy (3264x2448).
import zdjecieHero from '../assets/1746635357709.jpg'
import { zdjeciaMasazy, zdjecia, wzoryKart } from '../data/zdjecia'
// Kamil bez tła, stoi w ramce z doborem masażu.
import kamilWycinanka from '../assets/masaz-poz-kadr.png'
import Social from '../components/Social.astro'
import Opinie from '../components/Opinie.astro'
import PanelRezerwacji from '../components/PanelRezerwacji.astro'
import { ikony } from '../data/ikony'

const BAZA = 'https://rozluznijsie.pl'

/** Pierwsza cena z cennika danego masażu, np. „1 h: 160 zł” -> 160. */
const cenaOd = (ceny: string[]) => {
  const liczba = ceny.map((c) => c.match(/(\d+)\s*zł/)).find(Boolean)
  return liczba ? Number(liczba[1]) : null
}

/**
 * Uzupełnienie wizytówki z Layoutu: ten sam `@id`, więc Google skleja oba
 * węzły w jeden. Tutaj trzymamy rzeczy, które mają sens wyłącznie na stronie
 * głównej: katalog zabiegów z cenami i skład gabinetu.
 */
const katalogUslug = {
  '@context': 'https://schema.org',
  '@id': BAZA + '/#gabinet',
  alternateName: 'Salon masażu Piątkowo',
  slogan: 'Masaż w Poznaniu, stacjonarnie i z dojazdem',
  paymentAccepted: 'gotówka, karta płatnicza, przelew',
  employee: [
    { '@type': 'Person', name: 'Nicole Stokowska', jobTitle: 'Masażystka', url: BAZA + '/o-nas/nicole-stokowska' },
    { '@type': 'Person', name: 'Kamil Jędrzejewski', jobTitle: 'Masażysta', url: BAZA + '/o-nas/kamil-jedrzejewski' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Masaże w gabinecie Rozluźnij Się',
    itemListElement: masaze.map((m) => {
      const cena = cenaOd(m.ceny)
      return {
        '@type': 'Offer',
        url: BAZA + sciezkaMasazu(m.slug),
        itemOffered: {
          '@type': 'Service',
          name: m.nazwa,
          serviceType: m.nazwa,
          provider: { '@id': BAZA + '/#gabinet' },
          areaServed: { '@type': 'City', name: 'Poznań' },
        },
        ...(cena ? { price: cena, priceCurrency: 'PLN' } : {}),
        availability: 'https://schema.org/InStock',
      }
    }),
  },
}
---

<Layout
  tytul="Masaż Poznań – salon masażu Piątkowo | Rozluźnij Się"
  opis="Salon masażu na Piątkowie w Poznaniu: relaksacyjny, klasyczny, Kobido, sportowy i tkanek głębokich. Stacjonarnie i z dojazdem. Rezerwuj online lub zadzwoń."
>
  <section class="hero">
    <div class="hero-tlo">
      <Image src={zdjecieHero} alt="" widths={[1000, 1600]} width={1600} quality={58} sizes="100vw" loading="eager" fetchpriority="high" style="object-position:50% 62%" />
    </div>
    <span class="hero-lisc" aria-hidden="true"></span>

    <a class="hero-promo" href={firma.booksy} target="_blank" rel="noopener noreferrer">
      <span class="hero-promo-chip"><strong>-15%</strong></span>
      <span class="hero-promo-tekst">
        <span class="hero-promo-tytul">Pierwszy masaż taniej</span>
        <span class="hero-promo-drobne">Rezerwuj w Booksy</span>
      </span>
      <svg class="hero-promo-strzalka" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>

    <div class="kontener hero-siatka">
      <div class="hero-warstwa">
        <p class="hero-etykieta">Gabinet masażu w Poznaniu</p>
        <h1>Masaż Piątkowo Poznań</h1>
        <a class="hero-dostepni" href={firma.messenger} target="_blank" rel="noopener noreferrer">
          <span class="hero-awatary">
            <Image src={zdjecia.kamil} alt="Kamil Jędrzejewski" width={96} height={96} quality={80} loading="eager" />
            <Image src={zdjecia.nicole} alt="Nicole Stokowska" width={96} height={96} quality={80} loading="eager" />
          </span>
          <span class="hero-dostepni-tekst">
            <span class="hero-dostepni-glowny">
              <span class="hero-kropka" aria-hidden="true"></span>
              Masz pytania? <strong>Napisz</strong>
            </span>
            <span class="hero-dostepni-drobne">Messenger</span>
          </span>
        </a>

        <p class="hero-opis">
          Masaż relaksacyjny, klasyczny, sportowy, tkanek głębokich i Kobido.
          Pracujemy <strong>stacjonarnie na Piątkowie</strong> i <strong>z dojazdem do klienta</strong>
          w całym Poznaniu.
        </p>
        <div class="hero-cta">
          <a class="btn btn-glowny" href={firma.booksy} target="_blank" rel="noopener noreferrer"><span set:html={ikony.kalendarz} />Zarezerwuj online</a>
          <a class="btn btn-jasny" href={firma.telefonHref}><span set:html={ikony.telefon} />Zadzwoń: {firma.telefon}</a>
        </div>
        <p class="hero-dane">
          {firma.ulica}, {firma.kod} {firma.miasto} · rezerwacja telefoniczna
          <a href={firma.telefonHref}> {firma.telefon}</a>
        </p>
      </div>

      <aside class="hero-panel">
        <PanelRezerwacji />
      </aside>
    </div>

    <a class="hero-strzalka" href="#tresc-glowna" aria-label="Przewiń do treści">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
    </a>
  </section>

  <section class="sekcja sekcja-cta" id="tresc-glowna">
    <div class="kontener">
      <div class="ramka-cta">
        <div>
          <p class="etykieta">Rezerwacja</p>
          <h2>Wolny termin sprawdzisz w minutę</h2>
          <p>
            Kalendarz w Booksy jest <strong>zawsze aktualny</strong>, więc widzisz tam realnie wolne
            godziny, także na dziś i na jutro. Rezerwujesz o dowolnej porze, bez dzwonienia
            i bez czekania na odpowiedź.
          </p>
          <p>
            Nie wiesz, który zabieg wybrać? Zadzwoń pod <a href={firma.telefonHref}>{firma.telefon}</a>
            albo napisz. <strong>Dobierzemy masaż razem</strong>, jeszcze przed rezerwacją terminu.
          </p>
        </div>
        <div class="ramka-cta-akcje">
          <a class="btn btn-glowny" href={firma.booksy} target="_blank" rel="noopener noreferrer"><span set:html={ikony.kalendarz} />Zarezerwuj online</a>
          <a class="btn btn-jasny" href={firma.telefonHref}><span set:html={ikony.telefon} />Zadzwoń: {firma.telefon}</a>
          <p class="ramka-cta-drobne">Pierwszy masaż <strong>15% taniej</strong></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sekcja sekcja-jasna sekcja-lisc">
    <div class="kontener">
      <div class="dwie-kolumny dwie-kolumny-separator">
        <span class="separator-pionowy" aria-hidden="true"></span>

        <figure class="kadr kadr-zespol">
          <Image
            src={zdjecia.zespol}
            alt="Nicole Stokowska i Kamil Jędrzejewski w gabinecie masażu Rozluźnij Się w Poznaniu"
            widths={[560, 1000]}
            width={1000}
            quality={74}
            sizes="(max-width: 900px) 92vw, 48vw"
            loading="lazy"
          />
          <a class="podpis-osoby podpis-kamil" href="/o-nas/kamil-jedrzejewski">Kamil Jędrzejewski</a>
          <a class="podpis-osoby podpis-nicole" href="/o-nas/nicole-stokowska">Nicole Stokowska</a>
        </figure>

        <div>
          <p class="etykieta">Kim jesteśmy</p>
          <h2 class="tytul-sekcji tytul-mniejszy">Tworzymy przestrzeń, w której naprawdę możesz się rozluźnić</h2>
          <div class="proza">
            <p>
              Cześć! Jesteśmy <a href="/o-nas/nicole-stokowska">Nicole</a> i
              <a href="/o-nas/kamil-jedrzejewski">Kamil</a>, duetem, który wierzy, że masaż to coś
              więcej niż tylko technika. To <strong>moment dla ciała i dla głowy</strong>.
            </p>
            <p>
              Nicole specjalizuje się w <a href="/masaz-relaksacyjny-poznan">masażach relaksacyjnych</a>,
              uwielbia <a href="/masaze/kobido-poznan">Kobido UP</a> i rytuały, które otulają spokojem.
              Kamil lepiej czuje się w mocniejszych technikach: klasycznych, sportowych i
              <a href="/masaze/tkanek-glebokich-poznan"> pracy z tkankami głębokimi</a>.
            </p>
            <p>
              Różnimy się stylem, ale łączy nas wspólny cel: stworzyć miejsce, w którym można
              <strong>zwolnić, odetchnąć i po prostu poczuć się dobrze</strong>.
            </p>
          </div>

          <Social klasa="spoleczne-pod-tekstem" />

          <ul class="dane-kontaktowe">
            <li><span>Lokalizacja</span> {firma.ulica}, {firma.kod} {firma.miasto}</li>
            <li class="dane-prawo"><span>Rezerwacja telefoniczna</span> <a href={firma.telefonHref}>{firma.telefon}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sekcja sekcja-kroki-mobilne">
    <div class="kontener">
      <div class="hero-panel"><PanelRezerwacji /></div>
    </div>
  </section>

  <section class="sekcja sekcja-biala sekcja-napis">
    <span class="napis-pionowy" aria-hidden="true">MASAŻE</span>
    <div class="kontener">
      <p class="etykieta">Zakres usług</p>
      <h2 class="tytul-sekcji">Masaże, które wykonujemy</h2>
      <div class="proza proza-wstep">
        <p>
          Każdy masaż dobieramy do tego, z czym przychodzisz. Inaczej pracuje się z kimś,
          kto siedzi osiem godzin przy biurku, inaczej z osobą po treningu, a jeszcze inaczej,
          kiedy celem jest po prostu <strong>wyciszenie i sen</strong>.
        </p>
        <p>
          Dlatego każdą wizytę zaczynamy od krótkiej rozmowy. Pytamy, co boli, jak długo,
          czy były urazy i jak wygląda Twój zwykły dzień. Na tej podstawie ustalamy nie tylko
          rodzaj zabiegu, ale też <strong>intensywność i partie ciała</strong>, którym poświęcimy
          najwięcej czasu. Ten sam masaż klasyczny potrafi być zupełnie inny dla dwóch osób.
        </p>
        <p>
          Poniżej znajdziesz wszystkie zabiegi, jakie wykonujemy w gabinecie na Piątkowie.
          Większość z nich robimy też <a href="/dojazd">z dojazdem do klienta</a> w całym Poznaniu,
          a wybrane także <a href="/dla-firm">w firmach</a>. Ceny i pakiety zebraliśmy
          w <a href="/cennik-masazu-poznan">cenniku</a>.
        </p>
      </div>

      <div class="karty">
        {masaze.map((m) => (
          <a class="karta" href={sciezkaMasazu(m.slug)}>
            {m.plakietka && <span class="karta-plakietka">{m.plakietka}</span>}
            <div class="karta-foto">
              <Image src={zdjeciaMasazy[m.slug]} alt={m.alt} widths={[380, 640]} width={640} quality={70} sizes="(max-width: 900px) 92vw, 30vw" loading="lazy" />
            </div>
            <div class="karta-tresc">
              <h3 class="karta-tytul">{m.nazwa}</h3>
              {wskazania[m.slug] && (

                <span class={`karta-wskazanie karta-wskazanie-${wskazania[m.slug].kolor}`}>{wskazania[m.slug].tekst}</span>

              )}
              <p class="karta-cena" set:html={m.opis} />
              <span class="karta-wiecej">Zobacz szczegóły →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sekcja sekcja-biala sekcja-dobor">
    <div class="kontener">
      <div class="ramka-dobor">
        <div class="ramka-dobor-tresc">
          <p class="etykieta">Nie wiesz, co wybrać?</p>
          <h2>Powiedz, co Cię boli. Resztę dobierzemy sami</h2>
          <p>
            Nie musisz znać nazw technik. Rezerwujesz dowolny termin, a przed zabiegiem
            w kilka minut ustalamy, <strong>czego naprawdę potrzebuje Twoje ciało</strong>:
            mocnej pracy na napiętym karku czy spokojnego wyciszenia. <strong>Siłę nacisku
            dopasowujemy w trakcie</strong>, więc masaż nie będzie ani za mocny, ani za
            delikatny.
          </p>
          <div class="ramka-dobor-akcje">
            <a class="btn btn-glowny" href={firma.booksy} target="_blank" rel="noopener noreferrer"><span set:html={ikony.kalendarz} />Zarezerwuj online</a>
            <a class="btn btn-jasny" href={firma.telefonHref}><span set:html={ikony.telefon} />Zadzwoń: {firma.telefon}</a>
          </div>
        </div>

        <figure class="ramka-dobor-foto">
          <Image
            src={kamilWycinanka}
            alt="Kamil Jędrzejewski z gorącymi kamieniami do masażu"
            widths={[400, 800]}
            width={800}
            quality={88}
            sizes="(max-width: 980px) 260px, 400px"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="sekcja sekcja-zielona sekcja-duo">
    <div class="kontener">
      <div class="duo">
        <figure class="duo-foto">
          <div class="duo-foto-glowne">
            <Image
              src={zdjecia.dojazdAuto}
              alt="Masażysta ze składanym stołem przy oznakowanym aucie gabinetu Rozluźnij Się w Poznaniu"
              widths={[560, 1000]}
              width={1000}
              quality={72}
              sizes="(max-width: 900px) 92vw, 46vw"
              loading="lazy"
            />
          </div>
          <div class="duo-foto-male">
            <Image
              src={zdjecia.dojazdSprzet}
              alt="Masażysta wyjmuje z auta składany stół i torby ze sprzętem do masażu"
              widths={[300, 560]}
              width={560}
              quality={72}
              sizes="(max-width: 900px) 40vw, 20vw"
              loading="lazy"
            />
          </div>
        </figure>

        <div class="duo-tresc">
          <p class="etykieta">Masaż z dojazdem</p>
          <h2 class="tytul-sekcji">Przyjeżdżamy do Ciebie z całym sprzętem</h2>
          <div class="proza">
            <p>
              Nie zawsze jest czas i siła, żeby po pracy jechać przez miasto. W takie dni
              <strong> to my przyjeżdżamy do Ciebie</strong>: do domu, do mieszkania albo do biura,
              własnym autem i z pełnym wyposażeniem.
            </p>
          </div>

          <ul class="lista-cech">
            <li>Profesjonalny stół składany albo krzesło do masażu biurowego</li>
            <li>Olejki, ręczniki i akcesoria zawsze bierzemy ze sobą</li>
            <li>Ty przygotowujesz tylko <strong>2×2 m wolnej przestrzeni</strong> i spokojną godzinę</li>
            <li>Po zabiegu nigdzie nie jedziesz. Zostajesz tam, gdzie jesteś</li>
          </ul>

          <div class="duo-akcje">
            <a class="btn btn-glowny" href={firma.booksy} target="_blank" rel="noopener noreferrer"><span set:html={ikony.kalendarz} />Zarezerwuj dojazd</a>
            <a class="btn btn-jasny" href="/dojazd"><span set:html={ikony.samochod} />Jak to działa</a>
          </div>

          <p class="duo-drobne">Dojeżdżamy w całym Poznaniu:</p>
          <ul class="lista-dzielnic">
            {dzielnice.map((d) => (
              <li><a href={`/dojazd/${d.slug}`}>{d.nazwa}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sekcja sekcja-biala sekcja-duo">
    <div class="kontener">
      <div class="duo duo-odwrotnie">
        <div class="duo-tresc">
          <p class="etykieta">Karty podarunkowe</p>
          <h2 class="tytul-sekcji">Prezent, który nie skończy się w szufladzie</h2>
          <div class="proza">
            <p>
              Karta podarunkowa na masaż to godzina spokoju dla kogoś, kto zwykle odkłada siebie
              na koniec listy. <strong>Na urodziny, rocznicę, święta</strong> albo zwyczajnie
              za to, że ktoś jest.
            </p>
          </div>

          <ul class="lista-cech">
            <li>Na <strong>konkretny zabieg</strong> albo na wybraną kwotę</li>
            <li>Karta w kopercie do odbioru w gabinecie lub <strong>plik PDF na maila</strong></li>
            <li>Obdarowana osoba sama wybiera termin i rodzaj masażu</li>
            <li>Realizacja w gabinecie na Piątkowie, a po ustaleniu także z dojazdem</li>
          </ul>

          <div class="duo-akcje">
            <a class="btn btn-zielony" href="/vouchery"><span set:html={ikony.prezent} />Zobacz karty podarunkowe</a>
            <a class="btn btn-obrys" href={firma.telefonHref}><span set:html={ikony.telefon} />Zamów telefonicznie</a>
          </div>
        </div>

        <figure class="duo-foto">
          <div class="duo-foto-glowne">
            <Image
              src={zdjecia.voucherKoperta}
              alt="Karta podarunkowa na masaż w bordowej kopercie przewiązanej złotą wstążką"
              widths={[560, 1000]}
              width={1000}
              quality={74}
              sizes="(max-width: 900px) 92vw, 46vw"
              loading="lazy"
            />
          </div>
          <div class="duo-foto-male">
            <Image
              src={zdjecia.voucherWRece}
              alt="Karty podarunkowe gabinetu Rozluźnij Się trzymane w dłoni na tle stołu do masażu"
              widths={[300, 560]}
              width={560}
              quality={74}
              sizes="(max-width: 900px) 40vw, 20vw"
              loading="lazy"
            />
          </div>
        </figure>
      </div>

      <div class="wzory-suwak" data-suwak-grupa>
        <div class="wzory-suwak-glowka">
          <div>
            <p class="wzory-suwak-tytul">Wzory do wyboru</p>
            <p class="wzory-suwak-opis">Wzór dobieramy do okazji. Nie masz preferencji? Bierzemy klasyczny.</p>
          </div>
          <div class="opinie-strzalki">
            <button type="button" class="opinie-strzalka" data-suwak-strzalka="-1" aria-label="Poprzednie wzory kart">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
            </button>
            <button type="button" class="opinie-strzalka" data-suwak-strzalka="1" aria-label="Następne wzory kart">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </button>
          </div>
        </div>

        <div class="tasma" data-suwak tabindex="0" role="group" aria-label="Wzory kart podarunkowych, przewiń w bok">
          {wzoryKart.map((w) => (
            <figure class="wzor-karty">
              <Image
                src={w.zdjecie}
                alt={w.alt}
                widths={[380, 760]}
                width={760}
                quality={76}
                sizes="(max-width: 700px) 86vw, 31vw"
                loading="lazy"
              />
              <figcaption>{w.nazwa}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sekcja sekcja-jasna">
    <div class="kontener">
      <p class="etykieta">Masaż w Poznaniu</p>
      <h2 class="tytul-sekcji">Gabinet masażu Poznań</h2>
      <div class="proza proza-szeroka">
        <p>
          Gabinet <strong>Rozluźnij Się</strong> działa na Piątkowie, przy ulicy Piątkowskiej 94,
          wejście C. To spokojna część Poznania z dobrym dojazdem i miejscem na samochód pod
          budynkiem, więc wizyta nie zaczyna się od szukania parkingu. Przyjmujemy
          <strong> jedną osobę naraz</strong>, bez poczekalni pełnej ludzi i bez pośpiechu.
        </p>
        <p>
          Pracujemy z tym, co przynosi codzienność: sztywnym karkiem po dniu przy monitorze,
          bólem między łopatkami, ciężkimi nogami i napięciem, które trzyma się barków od tygodni.
          Do każdej z tych rzeczy pasuje inny zabieg, dlatego mamy w ofercie zarówno delikatny
          <a href="/masaz-relaksacyjny-poznan"> masaż relaksacyjny</a>, jak i mocny
          <a href="/masaze/tkanek-glebokich-poznan"> masaż tkanek głębokich</a>, a pomiędzy nimi
          <a href="/masaze/klasyczny-poznan"> masaż klasyczny</a> i
          <a href="/masaze/sportowy-poznan"> sportowy</a>.
        </p>
        <p>
          Nie każdy może albo chce dojechać do gabinetu. Dlatego równolegle prowadzimy
          <a href="/dojazd"> masaż z dojazdem</a> po całym Poznaniu: przyjeżdżamy z własnym
          składanym stołem, wałkami i olejem na <a href="/dojazd/winogrady-poznan">Winogrady</a>,
          <a href="/dojazd/jezyce-poznan"> Jeżyce</a>, <a href="/dojazd/grunwald-poznan">Grunwald</a>,
          <a href="/dojazd/solacz-poznan"> Sołacz</a>, <a href="/dojazd/podolany-poznan">Podolany</a>,
          <a href="/dojazd/winiary-poznan"> Winiary</a> i <a href="/dojazd/ogrody-poznan">Ogrody</a>.
          Ta forma ma jedną przewagę nad gabinetem: <strong>po zabiegu nie musisz nigdzie jechać</strong>.
        </p>
        <p>
          Osobny rozdział to firmy. <a href="/dla-firm">Masaż dla firm</a> i
          <a href="/dla-firm/masaz-biurowy-poznan"> masaż biurowy</a> robimy na krześle do masażu,
          bez rozbierania i bez organizowania osobnego pokoju. Kilkanaście minut na kark i barki
          potrafi zmienić drugą połowę dnia pracy, a dla pracodawcy jest to
          <strong> benefit, z którego korzystają wszyscy</strong>, nie tylko chętni na siłownię.
        </p>
        <p>
          Jeśli jesteś u nas <a href="/pierwsza-wizyta">pierwszy raz</a>, nic nie musisz
          przygotowywać. Odpowiedzi na najczęstsze pytania zebraliśmy w
          <a href="/faq"> sekcji FAQ</a>, a o tym, co dzieje się w ciele przy pracy siedzącej
          czy przewlekłym stresie, piszemy <a href="/blog">na blogu</a>. Terminy i aktualne ceny
          znajdziesz w Booksy, a jeśli wolisz ustalić wszystko głosem, po prostu
          <a href="/kontakt"> zadzwoń</a>.
        </p>
