---
/**
 * Slider z opiniami z Google i Booksy. Przewijanie robi natywny scroll ze
 * scroll-snap (działa palcem, gładzikiem i klawiaturą), strzałki tylko
 * dokładają wygodę myszką. Bez bibliotek i bez zewnętrznych skryptów.
 */
import { firma } from '../config'
import { opinie } from '../data/opinie'
import { ikony } from '../data/ikony'

const gwiazdka =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"/></svg>'

// Firmowe „G" Google w oryginalnych kolorach: od razu widać, skąd są opinie.
const logoGoogle = `<svg viewBox="0 0 48 48" aria-hidden="true">
  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
</svg>`
---

<section class="sekcja sekcja-biala sekcja-opinie">
  <div class="kontener" data-suwak-grupa>
    <div class="opinie-naglowek">
      <div>
        <p class="etykieta">Opinie</p>
        <h2 class="tytul-sekcji tytul-opinie">Co mówią osoby po wizycie</h2>
        <p class="opinie-ocena">
          <span class="logo-google logo-google-duze" set:html={logoGoogle} />
          <span class="opinie-gwiazdki" aria-hidden="true">
            {[...Array(5)].map(() => <span set:html={gwiazdka} />)}
          </span>
        </p>
      </div>

      <div class="opinie-strzalki">
        <button type="button" class="opinie-strzalka" data-suwak-strzalka="-1" aria-label="Poprzednie opinie">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
        </button>
        <button type="button" class="opinie-strzalka" data-suwak-strzalka="1" aria-label="Następne opinie">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </button>
      </div>
    </div>

    <div class="opinie-tasma" id="opinie-tasma" data-suwak tabindex="0" role="group" aria-label="Opinie klientów, przewiń w bok">
      {opinie.map((o) => (
        <article class="opinia">
          <span class={`opinia-zrodlo opinia-zrodlo-${o.zrodlo}`}>
            {o.zrodlo === 'google' && <span class="logo-google" set:html={logoGoogle} />}
            {o.zrodlo === 'google' ? 'Google' : 'Booksy'}
          </span>
          <p class="opinia-gwiazdki" aria-label={`Ocena ${o.ocena} na 5`}>
            {[...Array(o.ocena)].map(() => <span set:html={gwiazdka} aria-hidden="true" />)}
          </p>
          <blockquote>{o.tekst}</blockquote>
          <p class="opinia-autor">{o.autor ?? 'Klient gabinetu'}</p>
        </article>
      ))}
    </div>

    <p class="opinie-cta">
      <a class="btn btn-obrys" href={firma.google} target="_blank" rel="noopener noreferrer">
        <span set:html={ikony.pinezka} />Zobacz wszystkie opinie w Google
      </a>
    </p>
  </div>
</section>
