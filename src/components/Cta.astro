---
import { firma } from '../config'
import { ikony } from '../data/ikony'

interface Props { tytul?: string; opis?: string }
const {
  tytul = 'Zarezerwuj termin',
  opis = 'Najprościej przez Booksy, ale możesz też po prostu zadzwonić. Odpowiadamy na wiadomości tak szybko, jak to możliwe.',
} = Astro.props
---

<section class="sekcja sekcja-zielona">
  <div class="kontener" style="text-align:center">
    <h2 class="tytul-sekcji" style="max-width:none;margin-inline:auto">{tytul}</h2>
    <p class="proza" style="max-width:58ch;margin:0 auto 28px">{opis}</p>
    <p style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:0">
      <a class="btn btn-glowny" href={firma.booksy} target="_blank" rel="noopener noreferrer"><span set:html={ikony.kalendarz} />Zarezerwuj online</a>
      <a class="btn btn-jasny" href={firma.telefonHref}><span set:html={ikony.telefon} />Zadzwoń: {firma.telefon}</a>
    </p>
  </div>
</section>
