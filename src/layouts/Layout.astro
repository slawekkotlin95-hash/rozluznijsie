---
import '../styles/global.css'
import Naglowek from '../components/Naglowek.astro'
import Stopka from '../components/Stopka.astro'
import Plywajace from '../components/Plywajace.astro'
import Lightbox from '../components/Lightbox.astro'
import { firma, godziny } from '../config'

interface Props {
  tytul: string
  opis: string
  /** Miniaturka do udostępnień. Domyślnie wspólna wizytówka z `public/og.jpg`. */
  obraz?: string
}
const { tytul, opis, obraz = '/og.jpg' } = Astro.props
const BAZA = 'https://rozluznijsie.pl'
const miniaturka = new URL(obraz, BAZA).href
const wizytowka = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  '@id': BAZA + '/#gabinet',
  name: 'Rozluźnij Się, gabinet masażu Poznań',
  description: 'Gabinet masażu na Piątkowie w Poznaniu. Masaż relaksacyjny, klasyczny, Kobido, sportowy, tkanek głębokich, bańką chińską i antycellulitowy. Stacjonarnie i z dojazdem.',
  url: BAZA,
  telephone: '+48572317407',
  email: firma.email,
  vatID: 'PL' + firma.nip,
  image: [BAZA + '/og.jpg'],
  logo: BAZA + '/favicon.png',
  hasMap: firma.google,
  currenciesAccepted: 'PLN',
  priceRange: '140-220 PLN',
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.ulica,
    postalCode: firma.kod,
    addressLocality: 'Poznań',
    addressRegion: 'wielkopolskie',
    addressCountry: 'PL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 52.430498, longitude: 16.9164255 },
  areaServed: [
    { '@type': 'City', name: 'Poznań' },
    ...['Piątkowo', 'Winogrady', 'Winiary', 'Podolany', 'Sołacz', 'Jeżyce', 'Grunwald', 'Ogrody'].map((n) => ({ '@type': 'Place', name: n })),
  ],
  sameAs: [firma.facebook, firma.instagram, firma.google, firma.booksy],
  openingHoursSpecification: godziny.map((g) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: 'https://schema.org/' + g.schema,
    opens: g.od,
    closes: g.do,
  })),
}

const kanoniczny = new URL(Astro.url.pathname, Astro.site ?? 'https://rozluznijsie.pl').href
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="dVqjgK1GRILtqVNeyYnmaGfBdOcAPIuDp6M_f7XLBCw" />
    <title>{tytul}</title>
    <meta name="description" content={opis} />
    <link rel="canonical" href={kanoniczny} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={firma.pelnaNazwa} />
    <meta property="og:url" content={kanoniczny} />
    <meta property="og:title" content={tytul} />
    <meta property="og:description" content={opis} />
    <meta property="og:image" content={miniaturka} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={firma.pelnaNazwa} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tytul} />
    <meta name="twitter:description" content={opis} />
    <meta name="twitter:image" content={miniaturka} />
    <meta name="theme-color" content="#1b4d3e" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Jost:wght@300;400;500;600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(wizytowka)} />
  </head>
  <body>
    <a class="pomijacz" href="#tresc">Przejdź do treści</a>
    <Naglowek />
    <main id="tresc"><slot /></main>
    <Stopka />

    <Plywajace />
    <Lightbox />
  </body>
</html>

<script>
  // Wspólna obsługa suwaków: przewijanie o szerokość kadru, żeby karty nie
  // urywały się w połowie. Palec, gładzik i klawiatura działają natywnie.
  document.querySelectorAll<HTMLButtonElement>('[data-suwak-strzalka]').forEach((przycisk) => {
    przycisk.addEventListener('click', () => {
      const tasma = przycisk.closest('[data-suwak-grupa]')?.querySelector('[data-suwak]') as HTMLElement
      if (!tasma) return
      const kierunek = Number(przycisk.dataset.suwakStrzalka)
      tasma.scrollBy({ left: kierunek * tasma.clientWidth * 0.9, behavior: 'smooth' })
    })
  })
</script>
