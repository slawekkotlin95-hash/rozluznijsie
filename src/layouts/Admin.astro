---
/**
 * Szkielet panelu /admin: sidebar, okruszki, toasty i strażnik sesji.
 *
 * Panel jest statycznym HTML-em, a wszystkie operacje idą przez funkcje
 * w /api/admin. Strażnik po stronie przeglądarki tylko przekierowuje na
 * logowanie — prawdziwa kontrola dostępu siedzi w endpointach.
 */
import { Image } from 'astro:assets'
import logo from '../assets/output-onlinepngtools.png'
import '../styles/admin.css'

interface Props {
  tytul: string
  podtytul?: string
  /** Który punkt menu podświetlić. */
  sekcja?: string
  /** Okruszki bez ostatniego elementu, ten bierze się z `tytul`. */
  okruszki?: { nazwa: string; href: string }[]
}

const { tytul, podtytul, sekcja = '', okruszki = [] } = Astro.props

const menu = [
  { id: 'pulpit', nazwa: 'Pulpit', href: '/admin', ikona: 'M4 13h7V4H4v9Zm0 7h7v-5H4v5Zm9 0h7v-9h-7v9Zm0-16v5h7V4h-7Z' },
  { id: 'blog', nazwa: 'Blog', href: '/admin/blog', ikona: 'M4 5h16M4 12h16M4 19h10' },
  { id: 'media', nazwa: 'Media', href: '/admin/media', ikona: 'M3 5h18v14H3zM3 15l5-5 4 4 3-3 6 6' },
]

const wkrotce = [
  { nazwa: 'Strony', ikona: 'M6 3h9l5 5v13H6z' },
  { nazwa: 'Kategorie', ikona: 'M4 6h16M4 12h16M4 18h16' },
  { nazwa: 'SEO', ikona: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM21 21l-4.3-4.3' },
  { nazwa: 'Menu', ikona: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01' },
  { nazwa: 'Użytkownicy', ikona: 'M16 21v-2a4 4 0 0 0-8 0v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z' },
  { nazwa: 'Ustawienia', ikona: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19 12a7 7 0 0 0-.1-1l2-1.6-2-3.4-2.4 1a7 7 0 0 0-1.7-1L14.5 3h-4l-.3 2.6a7 7 0 0 0-1.7 1l-2.4-1-2 3.4L6 11a7 7 0 0 0 0 2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 1.7 1l.3 2.6h4l.3-2.6a7 7 0 0 0 1.7-1l2.4 1 2-3.4-2-1.6c.1-.3.1-.7.1-1Z' },
]
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{tytul} · Panel Rozluźnij Się</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Jost:wght@400;500;600&display=swap"
    />
  </head>

  <body class="admin">
    <div class="a-uklad">
      <aside class="a-bok" id="bok">
        <a class="a-marka" href="/admin">
          <Image src={logo} alt="" width={68} height={68} quality={90} />
          <span>Rozluźnij Się<small>panel treści</small></span>
        </a>

        <nav class="a-nawigacja" aria-label="Sekcje panelu">
          {menu.map((p) => (
            <a href={p.href} aria-current={sekcja === p.id ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={p.ikona} /></svg>
              {p.nazwa}
            </a>
          ))}

          <p class="a-nawigacja-grupa">Kolejne etapy</p>
          {wkrotce.map((p) => (
            <a data-wkrotce title="Moduł zaplanowany na kolejny etap">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={p.ikona} /></svg>
              {p.nazwa}
            </a>
          ))}
        </nav>

        <div class="a-bok-dol">
          <div class="a-bok-uzytkownik">
            <strong id="uzytkownik-email">—</strong>
            administrator
          </div>
          <div class="a-nawigacja">
            <a href="/" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3" /></svg>
              Zobacz stronę
            </a>
            <a href="#" id="wyloguj">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
              Wyloguj
            </a>
          </div>
        </div>
      </aside>

      <div class="a-tresc">
        <header class="a-gora">
          <button class="a-btn a-btn-obrys a-menu-przycisk" id="menu-przycisk" aria-label="Menu panelu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>

          <nav class="a-okruszki" aria-label="Ścieżka">
            <a href="/admin">Pulpit</a>
            {okruszki.map((o) => (<><span aria-hidden="true">›</span><a href={o.href}>{o.nazwa}</a></>))}
            <span aria-hidden="true">›</span>
            <span aria-current="page">{tytul}</span>
          </nav>

          <div class="a-gora-akcje"><slot name="akcje" /></div>
        </header>

        <main class="a-strona">
          <h1>{tytul}</h1>
          {podtytul && <p class="a-podtytul">{podtytul}</p>}
          <slot />
        </main>
      </div>
    </div>

    <div class="a-toasty" id="toasty" role="status" aria-live="polite"></div>

    <script>
      // Strażnik: brak ważnej sesji = powrót na logowanie. Endpointy i tak
      // sprawdzają uprawnienia same, to jest wyłącznie wygoda interfejsu.
      const przekierujNaLogowanie = () => {
        location.replace('/admin/login?powrot=' + encodeURIComponent(location.pathname + location.search))
      }

      fetch('/api/admin/sesja')
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((d) => {
          const pole = document.getElementById('uzytkownik-email')
          if (pole) pole.textContent = d.email
        })
        .catch(przekierujNaLogowanie)

      document.getElementById('wyloguj')?.addEventListener('click', async (e) => {
        e.preventDefault()
        await fetch('/api/admin/sesja', { method: 'DELETE' })
        location.replace('/admin/login')
      })

      const bok = document.getElementById('bok')
      document.getElementById('menu-przycisk')?.addEventListener('click', () => {
        const otwarty = bok.hasAttribute('data-otwarty')
        if (otwarty) {
          bok.removeAttribute('data-otwarty')
          document.querySelector('.a-zaslona')?.remove()
          return
        }
        bok.setAttribute('data-otwarty', '')
        const zaslona = document.createElement('div')
        zaslona.className = 'a-zaslona'
        zaslona.addEventListener('click', () => {
          bok.removeAttribute('data-otwarty')
          zaslona.remove()
        })
        document.body.append(zaslona)
      })

      // Toasty i wspólny klient API dla wszystkich podstron panelu.
      window.toast = (tekst, blad = false) => {
        const el = document.createElement('div')
        el.className = 'a-toast' + (blad ? ' a-toast-blad' : '')
        el.textContent = tekst
        document.getElementById('toasty').append(el)
        setTimeout(() => el.remove(), 4200)
      }

      window.api = async (sciezka, opcje = {}) => {
        const odp = await fetch(sciezka, {
          ...opcje,
          headers: { 'Content-Type': 'application/json', ...(opcje.headers || {}) },
          body: opcje.dane ? JSON.stringify(opcje.dane) : opcje.body,
        })
        if (odp.status === 401) {
          przekierujNaLogowanie()
          throw new Error('Sesja wygasła.')
        }
        const wynik = await odp.json().catch(() => ({}))
        if (!odp.ok || wynik.ok === false) throw new Error(wynik.blad || 'Nie udało się wykonać operacji.')
        return wynik
      }
    </script>
  </body>
</html>
